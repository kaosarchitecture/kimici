{
  "name": "denk-app",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "routes": [{ "pattern": "app.denkmuhasebe.com", "custom_domain": true }],
  "assets": {
    "directory": "../admin-ui/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "DESK", "class_name": "MachineHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MachineHub"] }],
  "observability": { "enabled": true }
}
