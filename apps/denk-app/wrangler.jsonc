{
  "name": "denk-app",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "routes": [{ "pattern": "app.denkmuhasebe.com", "custom_domain": true }],
  "vars": { "XAI_MODEL": "grok-4.20-0309-reasoning" },
  "assets": {
    "directory": "../admin-ui/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "EVRAK", "class_name": "EvrakStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EvrakStore"] }],
  "observability": { "enabled": true }
}
